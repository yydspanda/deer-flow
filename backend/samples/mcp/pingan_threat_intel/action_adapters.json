{
  "adapters": [
    {
      "schema_version": "soc.mcp_action_adapter_config.v1",
      "enabled": true,
      "owner": "soc-platform",
      "environment": "dev-or-staging",
      "adapter_id": "threat-intel-pingan-mcp",
      "route": "threat_intel.ip_reputation.lookup",
      "action": "threat_intel.ip_reputation.lookup",
      "risk_level": "read_only",
      "adapter_kind": "mcp",
      "external_side_effect": "read",
      "dry_run_supported": true,
      "execute_supported": true,
      "idempotency_required": false,
      "required_payload_fields": ["ip"],
      "required_context_refs": ["thread_id"],
      "description": "Read-only PingAn ZEUS IP reputation lookup through an allowlisted MCP tool.",
      "payload_schema": {
        "type": "object",
        "required": ["ip"],
        "properties": {
          "ip": {"type": "string"},
          "context_refs": {"type": "object"}
        }
      },
      "metadata": {
        "tenant": "pingan",
        "work_package": "PI-01A",
        "evidence_boundary": "investigation_only",
        "decision_impact": "none"
      },
      "mcp": {
        "server": "pingan_threat_intel",
        "tool": "pingan_threat_intel_ip_reputation_lookup",
        "timeout_seconds": 15,
        "input_mapping": {"ip": "ip"},
        "output_fields": [
          "schema_version",
          "ip",
          "reputation_found",
          "reputation",
          "report_summaries",
          "label_evidence",
          "freshness_status",
          "queried_at",
          "duration_ms",
          "response_sha256",
          "mapping_warnings",
          "mocked",
          "provider_mode",
          "evidence_boundary",
          "decision_impact",
          "automation_eligible",
          "raw_response_included"
        ],
        "result_schema_version": "soc.pingan_threat_intel_result.v1"
      }
    }
  ]
}
