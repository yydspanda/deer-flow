{
  "adapters": [
    {
      "schema_version": "soc.mcp_action_adapter_config.v1",
      "enabled": true,
      "owner": "soc-platform",
      "environment": "dev-or-staging",
      "adapter_id": "security-tag-pingan-mcp",
      "route": "security_tag.lookup",
      "action": "security_tag.lookup",
      "risk_level": "read_only",
      "adapter_kind": "mcp",
      "external_side_effect": "read",
      "dry_run_supported": true,
      "execute_supported": true,
      "idempotency_required": false,
      "required_payload_fields": ["entity_key"],
      "required_context_refs": ["thread_id"],
      "description": "Read-only PingAn ZEUS security-tag lookup through an allowlisted MCP tool.",
      "payload_schema": {
        "type": "object",
        "required": ["entity_key"],
        "properties": {
          "entity_key": {"type": "string"},
          "entity_type": {"type": "string"},
          "context_refs": {"type": "object"}
        }
      },
      "metadata": {
        "tenant": "pingan",
        "work_package": "PI-01B1",
        "evidence_boundary": "investigation_only",
        "decision_impact": "none",
        "authorization_fact_created": false,
        "result_provenance_contract": "runtime_declared",
        "result_mode_field": "mocked"
      },
      "mcp": {
        "server": "pingan_security_tag",
        "tool": "pingan_security_tag_security_tag_lookup",
        "timeout_seconds": 15,
        "input_mapping": {
          "entity_key": "entity_key",
          "entity_type": "entity_type"
        },
        "output_fields": [
          "schema_version",
          "entity_key",
          "entity_type",
          "provider_records_found",
          "security_tag_found",
          "has_active",
          "lookup_status",
          "security_tag",
          "records",
          "provider_record_count",
          "records_omitted_count",
          "provider_version",
          "response_sha256",
          "source_freshness",
          "queried_at",
          "duration_ms",
          "mapping_warnings",
          "mocked",
          "provider_mode",
          "evidence_boundary",
          "decision_impact",
          "authorization_fact_created",
          "automation_eligible",
          "raw_response_included"
        ],
        "result_schema_version": "soc.pingan_security_tag_result.v1"
      }
    }
  ]
}
