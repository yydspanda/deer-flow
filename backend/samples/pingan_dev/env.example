# Source this file from the repository root after copying it to a local file
# ending in `.local`. Values shown as placeholders must be filled on the
# internal Mac and must not be committed.

export env_profile="LOCAL"
export DEER_FLOW_CONFIG_PATH="$PWD/config.pingan-dev.local"
export DEER_FLOW_EXTENSIONS_CONFIG_PATH="$PWD/backend/samples/pingan_dev/extensions.example.json"

export PINGAN_LITELLM_BASE_URL="http://localhost:4001/v1/"
export PINGAN_LITELLM_API_KEY="<internal-local-proxy-key>"
export PINGAN_LITELLM_MODEL="DeepSeek_V4_Flash"
export SOC_ANALYZER_MODE="llm"
export SOC_LLM_MODEL="deepseek-v4-flash"
export SOC_VALIDATION_MODEL="deepseek-v4-flash"
export SOC_LLM_MAX_CONCURRENCY="1"
export SOC_LLM_CALL_TIMEOUT_SECONDS="600"
export SOC_LLM_SENSITIVE_EVIDENCE_MODE="full"

export SOC_PINGAN_ENV="dev"
export SOC_PINGAN_ASSET_PROVIDER_MODE="internal"
export SOC_PINGAN_PROVIDER_IMPORT_PATHS="<internal-python-import-roots>"
export SOC_PINGAN_ZEUS_BASE_URL="<internal-zeus-dev-url>"
export SOC_PINGAN_ZEUS_ALLOWED_HOSTS="<internal-zeus-dev-host>"
export SOC_PINGAN_ZEUS_APP_ID="<internal-app-id>"
export SOC_PINGAN_ZEUS_APP_KEY="<internal-app-key>"
export SOC_PINGAN_ZEUS_SIGNER_IMPORT="soc_agent.integrations.pingan.zeus_signing:isec_sign"
export SOC_PINGAN_ZEUS_ASSET_PATH="/public/searchAssetInfo"
export SOC_PINGAN_ZEUS_COMPANY_CODE="all"
export SOC_PINGAN_ZEUS_QUERY_TYPE="1"
export SOC_PINGAN_ZEUS_PAGE_SIZE="10"
export SOC_PINGAN_ZEUS_TIMEOUT_SECONDS="10"

# D12-B negative cases resolve these references only for their own invocation.
# Use approved DEV fault-injection values; never point them at production.
export D12B_INVALID_ZEUS_APP_KEY="<approved-invalid-dev-key>"
export D12B_TIMEOUT_ZEUS_BASE_URL="<approved-unreachable-or-delayed-dev-url>"
export D12B_TIMEOUT_ZEUS_ALLOWED_HOSTS="<approved-timeout-dev-host>"
export D12B_TIMEOUT_SECONDS="1"

export SOC_PINGAN_ASSET_WORKFLOW_ENABLED="true"
export SOC_PINGAN_WORKFLOW_RUNNER_IMPORT="model.agent_platform.util_tools:run_workflow"
export SOC_PINGAN_WORKFLOW_APP_ID="YHSYS"
export SOC_PINGAN_WORKFLOW_OPERATOR="<internal-service-operator>"
export SOC_PINGAN_WORKFLOW_TERMINAL_ID="1087710"
export SOC_PINGAN_WORKFLOW_DATACENTER_ID="1087787"
export SOC_PINGAN_WORKFLOW_USER_ID="1092332"

export SOC_PINGAN_ASSET_MCP_PYTHON="$PWD/backend/.venv/bin/python"
export SOC_PINGAN_ASSET_MCP_SERVER="$PWD/backend/scripts/soc_pingan_asset_mcp_server.py"

export SOC_PINGAN_SOFTWARE_PATH_CATALOG_PATH="$PWD/backend/.deer-flow/pingan-context/software-path-catalog.sqlite"
export SOC_PINGAN_SOFTWARE_PATH_FRESHNESS_DAYS="180"
export SOC_PINGAN_SOFTWARE_PATH_MCP_PYTHON="$PWD/backend/.venv/bin/python"
export SOC_PINGAN_SOFTWARE_PATH_MCP_SERVER="$PWD/backend/scripts/soc_pingan_software_path_mcp_server.py"

export SOC_PINGAN_THREAT_INTEL_PROVIDER_MODE="internal"
export SOC_PINGAN_THREAT_INTEL_PATH="/public/indicatorSearch"
export SOC_PINGAN_THREAT_INTEL_TIMEOUT_SECONDS="10"
export SOC_PINGAN_THREAT_INTEL_MAX_RESPONSE_BYTES="2000000"
export SOC_PINGAN_THREAT_INTEL_FRESHNESS_DAYS="180"
export SOC_PINGAN_THREAT_INTEL_TIMEZONE="Asia/Shanghai"
export SOC_PINGAN_THREAT_INTEL_MCP_PYTHON="$PWD/backend/.venv/bin/python"
export SOC_PINGAN_THREAT_INTEL_MCP_SERVER="$PWD/backend/scripts/soc_pingan_threat_intel_mcp_server.py"

export SOC_PINGAN_SECURITY_TAG_PROVIDER_MODE="internal"
export SOC_PINGAN_SECURITY_TAG_PATH="/public/searchTagContent"
export SOC_PINGAN_SECURITY_TAG_TIMEOUT_SECONDS="10"
export SOC_PINGAN_SECURITY_TAG_MAX_RESPONSE_BYTES="2000000"
export SOC_PINGAN_SECURITY_TAG_TIMEZONE="Asia/Shanghai"
# Keep false until the ZEUS owner confirms that missing expireTime means permanent validity.
export SOC_PINGAN_SECURITY_TAG_ALLOW_OPEN_ENDED_VALIDITY="false"
export SOC_PINGAN_SECURITY_TAG_MCP_PYTHON="$PWD/backend/.venv/bin/python"
export SOC_PINGAN_SECURITY_TAG_MCP_SERVER="$PWD/backend/scripts/soc_pingan_security_tag_mcp_server.py"
