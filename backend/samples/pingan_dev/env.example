# Source this file from the repository root after copying it to a local file
# ending in `.local`. Values shown as placeholders must be filled on the
# internal Mac and must not be committed.

: "${SOC_REPO_ROOT:?Run: eval \"$(backend/.venv/bin/python backend/scripts/soc_pingan_local_paths.py --shell)\"}"
export DEER_FLOW_CONFIG_PATH="$SOC_REPO_ROOT/config.pingan-dev.local"
export DEER_FLOW_EXTENSIONS_CONFIG_PATH="$SOC_REPO_ROOT/backend/samples/pingan_dev/extensions.example.json"

export PINGAN_MODEL_GATEWAY_BASE_URL="http://127.0.0.1:4001/v1"
export PINGAN_MODEL_GATEWAY_API_KEY="<local-model-gateway-service-key>"
export PINGAN_MODEL_GATEWAY_MODEL="deepseek-v4-flash"
export PINGAN_MODEL_GATEWAY_SMOKE_THINKING_ENABLED="true"
export PINGAN_MODEL_GATEWAY_SMOKE_REASONING_EFFORT="high"

# Project-owned model gateway. These values replace sec_know_model/start_proxy.sh
# and LiteLLM. In the external preparation checkout, run
# soc_pingan_prepare_legacy_model_gateway_profile.py --apply to replace this
# placeholder block and create the ignored mode-0600 DER key.
export SOC_PINGAN_MODEL_GATEWAY_HOST="127.0.0.1"
export SOC_PINGAN_MODEL_GATEWAY_ENABLED="true"
export SOC_PINGAN_MODEL_GATEWAY_PORT="4001"
export SOC_PINGAN_MODEL_GATEWAY_API_KEYS="$PINGAN_MODEL_GATEWAY_API_KEY"
export SOC_PINGAN_MODEL_GATEWAY_MODEL_ALIAS="deepseek-v4-flash"
export SOC_PINGAN_MODEL_GATEWAY_UPSTREAM_MODEL="deepseek-v4-flash-0731"
export SOC_PINGAN_MODEL_GATEWAY_PROVIDER="eagw"
export SOC_PINGAN_MODEL_GATEWAY_UPSTREAM_BASE_URL="<internal-eagw-dev-or-stg-url>"
export SOC_PINGAN_MODEL_GATEWAY_ALLOWED_HOSTS="<internal-eagw-host>"
# Reviewed EAGW endpoints currently use trusted internal HTTP.
export SOC_PINGAN_MODEL_GATEWAY_ALLOW_INSECURE_HTTP="true"
export SOC_PINGAN_MODEL_GATEWAY_APP_KEY="<internal-model-app-key>"
export SOC_PINGAN_MODEL_GATEWAY_APP_SECRET="<internal-model-app-secret>"
export SOC_PINGAN_MODEL_GATEWAY_SCENE_ID="<deepseek-v4-flash-scene-id>"
export SOC_PINGAN_MODEL_GATEWAY_OPENAPI_CODE="API035059"
export SOC_PINGAN_MODEL_GATEWAY_OPENAPI_CREDENTIAL="<internal-openapi-credential>"
export SOC_PINGAN_MODEL_GATEWAY_RSA_PRIVATE_KEY_FILE="$SOC_REPO_ROOT/.secrets/eagw-private-key.der"
export SOC_PINGAN_MODEL_GATEWAY_MAX_CONCURRENCY="3"
export SOC_PINGAN_MODEL_GATEWAY_ADMISSION_TIMEOUT_SECONDS="5"
export SOC_PINGAN_MODEL_GATEWAY_UPSTREAM_TIMEOUT_SECONDS="600"
export SOC_PINGAN_MODEL_GATEWAY_MAX_REQUEST_BYTES="2000000"
export SOC_ANALYZER_MODE="llm"
export SOC_LLM_MODEL="deepseek-v4-flash"
export SOC_VALIDATION_MODEL="deepseek-v4-flash"
export SOC_LLM_MAX_CONCURRENCY="3"
export SOC_LLM_CALL_TIMEOUT_SECONDS="600"
export SOC_LLM_SENSITIVE_EVIDENCE_MODE="full"
# One bounded output-contract retry. Set a stronger registered model only when
# the internal environment has approved the additional latency/cost.
export SOC_LLM_OUTPUT_RETRY_ATTEMPTS="1"
export SOC_LLM_OUTPUT_FALLBACK_MODEL=""
export SOC_ROLE_VERIFIER_ENABLED="false"
# Enable only for the controlled direction/role comparison run. Omit the model
# to reuse SOC_LLM_MODEL, or set another registered DeerFlow model name.
export SOC_ROLE_VERIFIER_MODEL="deepseek-v4-pro"
export SOC_ROLE_VERIFIER_MIN_CONFIDENCE="0.65"

# Old ZEUS ingress compatibility. Keep fake mode until the internal direct
# provider smokes pass; switching to internal never falls back to fake.
# Preserve the old internal 8090 ingress so ZEUS can call this Mac directly.
# Restrict the macOS firewall to the trusted DEV/STG network. The model gateway
# on 4001 remains loopback-only.
export SOC_PINGAN_COMPAT_HOST="0.0.0.0"
export SOC_PINGAN_COMPAT_ENABLED="true"
export SOC_PINGAN_COMPAT_PORT="8090"
export SOC_PINGAN_COMPAT_APP_KEYS_JSON='{"common":"<legacy-zeus-api-key>"}'
export SOC_PINGAN_COMPAT_AUTO_MIGRATE="true"
export SOC_PINGAN_COMPAT_MAX_REQUEST_BYTES="5000000"
export SOC_PINGAN_COMPAT_SMOKE_BASE_URL="http://127.0.0.1:8090"
export SOC_PINGAN_COMPAT_SMOKE_TIMEOUT_SECONDS="900"
export SOC_PINGAN_COMPAT_SMOKE_POLL_INTERVAL_SECONDS="1"
export SOC_PINGAN_COMPAT_SMOKE_MAX_RESPONSE_BYTES="5000000"
export SOC_PINGAN_LEGACY_QUEUE_TTL_SECONDS="1800"
export SOC_PINGAN_LEGACY_LIFECYCLE_MODE="fake"
export SOC_PINGAN_LEGACY_CALLBACK_MODE="fake"
export SOC_PINGAN_LEGACY_WORKER_CONCURRENCY="1"
export SOC_PINGAN_LEGACY_POLL_INTERVAL_SECONDS="1"
export SOC_PINGAN_LEGACY_WORKER_LEASE_SECONDS="900"
export SOC_PINGAN_LEGACY_WORKER_MAX_ATTEMPTS="3"
export SOC_PINGAN_LEGACY_CALLBACK_MAX_ATTEMPTS="8"
export SOC_PINGAN_LEGACY_WORKER_AUTO_MIGRATE="false"

# One governed deployment selector. Use the switch command instead of editing
# active remote-target values by hand. The approved mappings are project DEV ->
# ZEUS PRD + Agent Platform PRD and project STG -> ZEUS STG + Agent Platform
# STG. The model target, Provider modes, and action authority remain independent.
export SOC_PINGAN_ENV="dev"
export SOC_TENANT_POLICY_ENABLED="true"
export SOC_TENANT_DISPOSITION_POLICY_PATH="$SOC_REPO_ROOT/backend/soc_agent/integrations/pingan/policies/tenant-disposition-v2.json"
export SOC_TENANT_POLICY_ENVIRONMENT="$SOC_PINGAN_ENV"
export SOC_TENANT_POLICY_EVENT_TIMEZONE="Asia/Shanghai"
export SOC_PINGAN_ASSET_PROVIDER_MODE="internal"
# Stored private profiles used by soc_pingan_set_runtime_environment.py.
export SOC_PINGAN_ZEUS_PRD_BASE_URL="https://isec-gw.paic.com.cn"
export SOC_PINGAN_ZEUS_PRD_ALLOWED_HOSTS="isec-gw.paic.com.cn"
export SOC_PINGAN_ZEUS_PRD_APP_ID="SEC-MODEL"
export SOC_PINGAN_ZEUS_PRD_APP_KEY="<internal-prd-app-key>"
export SOC_PINGAN_ZEUS_STG_BASE_URL="https://isec-gw-stg.paic.com.cn"
export SOC_PINGAN_ZEUS_STG_ALLOWED_HOSTS="isec-gw-stg.paic.com.cn"
export SOC_PINGAN_ZEUS_STG_APP_ID="SEC-MODEL"
export SOC_PINGAN_ZEUS_STG_APP_KEY="<internal-stg-app-key>"
# Active profile for the initial project DEV environment.
export SOC_PINGAN_ZEUS_ENV="prd"
export SOC_PINGAN_ZEUS_BASE_URL="https://isec-gw.paic.com.cn"
export SOC_PINGAN_ZEUS_ALLOWED_HOSTS="isec-gw.paic.com.cn"
export SOC_PINGAN_ZEUS_APP_ID="SEC-MODEL"
export SOC_PINGAN_ZEUS_APP_KEY="<internal-app-key>"
export SOC_PINGAN_ZEUS_PRD_CONFIRMATION="CALL_PINGAN_ZEUS_PRD"
export SOC_PINGAN_ZEUS_ASSET_PATH="/public/searchAssetInfo"
export SOC_PINGAN_ZEUS_COMPANY_CODE="all"
export SOC_PINGAN_ZEUS_QUERY_TYPE="1"
export SOC_PINGAN_ZEUS_PAGE_SIZE="10"
export SOC_PINGAN_ZEUS_TIMEOUT_SECONDS="10"
export SOC_PINGAN_ZEUS_ALERT_BRIEF_PATH="/public/getAlertBrief"
export SOC_PINGAN_ZEUS_ALERT_CALLBACK_PATH="/public/alertModelCallback"

# D12-B negative cases may override only the credential or timeout for one invocation.
# Run them only with explicit approval against the active mapped ZEUS target.
export D12B_INVALID_ZEUS_APP_KEY="<approved-invalid-dev-key>"
export D12B_TIMEOUT_SECONDS="0.001"

export SOC_PINGAN_ASSET_WORKFLOW_ENABLED="true"
# Run soc_pingan_prepare_legacy_workflow_profile.py before building the private
# overlay. It imports the reviewed PRD identity and both endpoint origins without
# printing credentials. The old source has no STG YHSYS identity/workflow IDs;
# the STG owner must provide that complete profile before switching project STG.
# Stored profiles used by soc_pingan_set_runtime_environment.py:
export SOC_PINGAN_WORKFLOW_PRD_BASE_URL="https://agents-api-sze.paic.com.cn"
export SOC_PINGAN_WORKFLOW_PRD_ALLOWED_HOSTS="agents-api-sze.paic.com.cn"
export SOC_PINGAN_WORKFLOW_PRD_APP_ID="YHSYS"
export SOC_PINGAN_WORKFLOW_PRD_APP_SECRET="<prepared-from-reviewed-legacy-prd-profile>"
export SOC_PINGAN_WORKFLOW_PRD_TERMINAL_ID="1087710"
export SOC_PINGAN_WORKFLOW_PRD_DATACENTER_ID="1087787"
export SOC_PINGAN_WORKFLOW_PRD_USER_ID="1092332"
export SOC_PINGAN_WORKFLOW_STG_BASE_URL="https://agents-api-stg-new.paic.com.cn"
export SOC_PINGAN_WORKFLOW_STG_ALLOWED_HOSTS="agents-api-stg-new.paic.com.cn"
export SOC_PINGAN_WORKFLOW_STG_APP_ID="<reviewed-stg-workflow-app-id>"
export SOC_PINGAN_WORKFLOW_STG_APP_SECRET="<reviewed-stg-workflow-app-secret>"
export SOC_PINGAN_WORKFLOW_STG_TERMINAL_ID="<reviewed-stg-terminal-workflow-id>"
export SOC_PINGAN_WORKFLOW_STG_DATACENTER_ID="<reviewed-stg-datacenter-workflow-id>"
export SOC_PINGAN_WORKFLOW_STG_USER_ID="<reviewed-stg-user-workflow-id>"
# Active profile for the initial project DEV environment. Both live runners still
# require explicit --confirm-live.
export SOC_PINGAN_WORKFLOW_ENV="prd"
export SOC_PINGAN_WORKFLOW_BASE_URL="https://agents-api-sze.paic.com.cn"
export SOC_PINGAN_WORKFLOW_ALLOWED_HOSTS="agents-api-sze.paic.com.cn"
export SOC_PINGAN_WORKFLOW_APP_ID="YHSYS"
export SOC_PINGAN_WORKFLOW_APP_SECRET="<prepared-from-reviewed-legacy-prd-profile>"
export SOC_PINGAN_WORKFLOW_TERMINAL_ID="1087710"
export SOC_PINGAN_WORKFLOW_DATACENTER_ID="1087787"
export SOC_PINGAN_WORKFLOW_USER_ID="1092332"
export SOC_PINGAN_WORKFLOW_AUTH_PATH="/appid/auth/login"
export SOC_PINGAN_WORKFLOW_REQUEST_TIMEOUT_SECONDS="15"
export SOC_PINGAN_WORKFLOW_TIMEOUT_SECONDS="600"
export SOC_PINGAN_WORKFLOW_POLL_INTERVAL_SECONDS="2"
export SOC_PINGAN_WORKFLOW_TOKEN_TTL_SECONDS="3600"
export SOC_PINGAN_WORKFLOW_MAX_REQUEST_BYTES="1000000"
export SOC_PINGAN_WORKFLOW_MAX_RESPONSE_BYTES="2000000"
# Required in addition to each live runner's explicit --confirm-live switch.
export SOC_PINGAN_WORKFLOW_PRD_CONFIRMATION="CALL_PINGAN_PRD"

export SOC_PINGAN_ASSET_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_ASSET_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_asset_mcp_server.py"

export SOC_PINGAN_SOFTWARE_PATH_CATALOG_PATH="$SOC_REPO_ROOT/backend/.deer-flow/pingan-context/software-path-catalog.sqlite"
export SOC_PINGAN_SOFTWARE_PATH_FRESHNESS_DAYS="180"
# Default-off throughput mode: when enabled, complete exact safe-path or safe-family
# coverage may directly produce PingAn operational disposition=ignored.
export SOC_PINGAN_SOFTWARE_PATH_FAST_POLICY_ENABLED="false"
export SOC_PINGAN_SOFTWARE_PATH_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_SOFTWARE_PATH_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_software_path_mcp_server.py"

export SOC_PINGAN_THREAT_INTEL_PROVIDER_MODE="internal"
export SOC_PINGAN_THREAT_INTEL_PATH="/public/indicatorSearch"
export SOC_PINGAN_THREAT_INTEL_TIMEOUT_SECONDS="10"
export SOC_PINGAN_THREAT_INTEL_MAX_RESPONSE_BYTES="2000000"
export SOC_PINGAN_THREAT_INTEL_FRESHNESS_DAYS="180"
export SOC_PINGAN_THREAT_INTEL_TIMEZONE="Asia/Shanghai"
export SOC_PINGAN_THREAT_INTEL_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_THREAT_INTEL_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_threat_intel_mcp_server.py"

export SOC_PINGAN_SECURITY_TAG_PROVIDER_MODE="internal"
export SOC_PINGAN_SECURITY_TAG_PATH="/public/searchTagContent"
export SOC_PINGAN_SECURITY_TAG_TIMEOUT_SECONDS="10"
export SOC_PINGAN_SECURITY_TAG_MAX_RESPONSE_BYTES="2000000"
export SOC_PINGAN_SECURITY_TAG_TIMEZONE="Asia/Shanghai"
# Keep false until the ZEUS owner confirms that missing expireTime means permanent validity.
export SOC_PINGAN_SECURITY_TAG_ALLOW_OPEN_ENDED_VALIDITY="false"
export SOC_PINGAN_SECURITY_TAG_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_SECURITY_TAG_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_security_tag_mcp_server.py"
