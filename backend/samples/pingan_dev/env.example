# Source this file from the repository root after copying it to a local file
# ending in `.local`. Values shown as placeholders must be filled on the
# internal Mac and must not be committed.

: "${SOC_REPO_ROOT:?Run: eval \"$(backend/.venv/bin/python backend/scripts/soc_pingan_local_paths.py --shell)\"}"
export DEER_FLOW_CONFIG_PATH="$SOC_REPO_ROOT/config.pingan-dev.local"
export DEER_FLOW_EXTENSIONS_CONFIG_PATH="$SOC_REPO_ROOT/backend/samples/pingan_dev/extensions.example.json"

export PINGAN_LITELLM_BASE_URL="http://localhost:4001/v1/"
export PINGAN_LITELLM_API_KEY="<internal-local-proxy-key>"
export PINGAN_LITELLM_MODEL="DeepSeek_V4_Flash"
export PINGAN_LITELLM_SMOKE_TIMEOUT_SECONDS="60"
export PINGAN_LITELLM_SMOKE_MAX_RESPONSE_BYTES="1000000"
export SOC_ANALYZER_MODE="llm"
export SOC_LLM_MODEL="deepseek-v4-flash"
export SOC_VALIDATION_MODEL="deepseek-v4-flash"
export SOC_LLM_MAX_CONCURRENCY="1"
export SOC_LLM_CALL_TIMEOUT_SECONDS="600"
export SOC_LLM_SENSITIVE_EVIDENCE_MODE="full"

export SOC_PINGAN_ENV="dev"
export SOC_TENANT_DISPOSITION_POLICY_PATH="$SOC_REPO_ROOT/backend/soc_agent/integrations/pingan/policies/tenant-disposition-v1.json"
export SOC_TENANT_POLICY_ENVIRONMENT="$SOC_PINGAN_ENV"
export SOC_TENANT_POLICY_EVENT_TIMEZONE="Asia/Shanghai"
export SOC_PINGAN_ASSET_PROVIDER_MODE="internal"
export SOC_PINGAN_ZEUS_BASE_URL="<internal-zeus-dev-url>"
export SOC_PINGAN_ZEUS_ALLOWED_HOSTS="<internal-zeus-dev-host>"
export SOC_PINGAN_ZEUS_APP_ID="<internal-app-id>"
export SOC_PINGAN_ZEUS_APP_KEY="<internal-app-key>"
export SOC_PINGAN_ZEUS_ASSET_PATH="/public/searchAssetInfo"
export SOC_PINGAN_ZEUS_COMPANY_CODE="all"
export SOC_PINGAN_ZEUS_QUERY_TYPE="1"
export SOC_PINGAN_ZEUS_PAGE_SIZE="10"
export SOC_PINGAN_ZEUS_TIMEOUT_SECONDS="10"

# D12-B negative cases resolve these references only for their own invocation.
# Use approved DEV fault-injection values; never point them at production.
export D12B_INVALID_ZEUS_APP_KEY="<approved-invalid-dev-key>"
export D12B_TIMEOUT_ZEUS_BASE_URL="<approved-unreachable-or-delayed-dev-url>"
export D12B_TIMEOUT_ZEUS_ALLOWED_HOSTS="<approved-timeout-dev-host>"
export D12B_TIMEOUT_SECONDS="1"

export SOC_PINGAN_ASSET_WORKFLOW_ENABLED="true"
# The reviewed ownership workflows use YHSYS, which exists only in the legacy
# PRD profile. Run soc_pingan_prepare_legacy_workflow_profile.py before building
# the private overlay; it replaces this tracked placeholder without printing the
# credential. Both live runners still require explicit --confirm-live.
export SOC_PINGAN_WORKFLOW_ENV="prd"
export SOC_PINGAN_WORKFLOW_BASE_URL="https://agents-api-sze.paic.com.cn"
export SOC_PINGAN_WORKFLOW_ALLOWED_HOSTS="agents-api-sze.paic.com.cn"
export SOC_PINGAN_WORKFLOW_APP_ID="YHSYS"
export SOC_PINGAN_WORKFLOW_APP_SECRET="<prepared-from-reviewed-legacy-prd-profile>"
export SOC_PINGAN_WORKFLOW_TERMINAL_ID="1087710"
export SOC_PINGAN_WORKFLOW_DATACENTER_ID="1087787"
export SOC_PINGAN_WORKFLOW_USER_ID="1092332"
export SOC_PINGAN_WORKFLOW_AUTH_PATH="/appid/auth/login"
export SOC_PINGAN_WORKFLOW_REQUEST_TIMEOUT_SECONDS="15"
export SOC_PINGAN_WORKFLOW_TIMEOUT_SECONDS="600"
export SOC_PINGAN_WORKFLOW_POLL_INTERVAL_SECONDS="2"
export SOC_PINGAN_WORKFLOW_TOKEN_TTL_SECONDS="3600"
export SOC_PINGAN_WORKFLOW_MAX_REQUEST_BYTES="1000000"
export SOC_PINGAN_WORKFLOW_MAX_RESPONSE_BYTES="2000000"
# Required in addition to each live runner's explicit --confirm-live switch.
export SOC_PINGAN_WORKFLOW_PRD_CONFIRMATION="CALL_PINGAN_PRD"

export SOC_PINGAN_ASSET_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_ASSET_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_asset_mcp_server.py"

export SOC_PINGAN_SOFTWARE_PATH_CATALOG_PATH="$SOC_REPO_ROOT/backend/.deer-flow/pingan-context/software-path-catalog.sqlite"
export SOC_PINGAN_SOFTWARE_PATH_FRESHNESS_DAYS="180"
export SOC_PINGAN_SOFTWARE_PATH_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_SOFTWARE_PATH_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_software_path_mcp_server.py"

export SOC_PINGAN_THREAT_INTEL_PROVIDER_MODE="internal"
export SOC_PINGAN_THREAT_INTEL_PATH="/public/indicatorSearch"
export SOC_PINGAN_THREAT_INTEL_TIMEOUT_SECONDS="10"
export SOC_PINGAN_THREAT_INTEL_MAX_RESPONSE_BYTES="2000000"
export SOC_PINGAN_THREAT_INTEL_FRESHNESS_DAYS="180"
export SOC_PINGAN_THREAT_INTEL_TIMEZONE="Asia/Shanghai"
export SOC_PINGAN_THREAT_INTEL_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_THREAT_INTEL_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_threat_intel_mcp_server.py"

export SOC_PINGAN_SECURITY_TAG_PROVIDER_MODE="internal"
export SOC_PINGAN_SECURITY_TAG_PATH="/public/searchTagContent"
export SOC_PINGAN_SECURITY_TAG_TIMEOUT_SECONDS="10"
export SOC_PINGAN_SECURITY_TAG_MAX_RESPONSE_BYTES="2000000"
export SOC_PINGAN_SECURITY_TAG_TIMEZONE="Asia/Shanghai"
# Keep false until the ZEUS owner confirms that missing expireTime means permanent validity.
export SOC_PINGAN_SECURITY_TAG_ALLOW_OPEN_ENDED_VALIDITY="false"
export SOC_PINGAN_SECURITY_TAG_MCP_PYTHON="$SOC_REPO_ROOT/backend/.venv/bin/python"
export SOC_PINGAN_SECURITY_TAG_MCP_SERVER="$SOC_REPO_ROOT/backend/scripts/soc_pingan_security_tag_mcp_server.py"
