# Scoped package-index profile for the trusted PingAn intranet.
# Native Host DEV loads it for the one-time locked install and later explicit
# dependency maintenance. The separate offline-bundle fallback does not use it.
# This repository uses uv, so this is the uv equivalent of a Poetry primary source.

export UV_DEFAULT_INDEX="http://maven.paic.com.cn:8445/repository/pypi/simple/"
# The current internal index uses plain HTTP. Scope the exception to this exact
# host and port, and enable it only while connected to the trusted intranet.
export UV_INSECURE_HOST="maven.paic.com.cn:8445"
