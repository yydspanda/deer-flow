# Example only: neither the CLI nor the SOC client automatically loads this file.
# Inject private values through the existing deployment environment; do not commit keys.
TRACE_AGENT_API_KEY=
TRACE_AGENT_PORT=8300
# Implement this factory before setting it, e.g. trace_agent.implementation:create_engine
TRACE_AGENT_ENGINE_FACTORY=

# Optional Mac Host process startup. It is NOT an investigation dispatch switch.
SOC_TRACE_ENABLED=false

# Explicit SOC client configuration; actual automatic dispatch is not implemented.
SOC_TRACE_AGENT_ENABLED=false
SOC_TRACE_AGENT_BASE_URL=http://127.0.0.1:8300
SOC_TRACE_AGENT_API_KEY=
SOC_TRACE_AGENT_TIMEOUT_SECONDS=30
SOC_TRACE_AGENT_MAX_RESPONSE_BYTES=4194304
