# SOC DEV uses an existing WAL database. Keep its patched SQLite runtime in a
# separate image layer; the generic upstream Gateway Dockerfile stays unchanged.
ARG BASE_IMAGE=deer-flow-dev-gateway:latest
FROM ${BASE_IMAGE} AS dev

# Official 3.51.3 release: https://sqlite.org/releaselog/3_51_3.html
# Verify both the archive and sqlite3.c against the pinned release identity.
RUN set -eu; \
    curl -fsSL --connect-timeout 15 --max-time 120 \
      https://www.sqlite.org/2026/sqlite-autoconf-3510300.tar.gz -o /tmp/soc-sqlite.tar.gz; \
    echo '81f5be397049b0cae1b167f2225af7646fc0f82e4a9b3c48c9ea3a533e21d77a  /tmp/soc-sqlite.tar.gz' | sha256sum -c -; \
    tar -xzf /tmp/soc-sqlite.tar.gz -C /tmp; \
    cd /tmp/sqlite-autoconf-3510300; \
    python -c 'import hashlib; from pathlib import Path; assert hashlib.sha3_256(Path("sqlite3.c").read_bytes()).hexdigest() == "32d5424f97e0a7fc5ed2f6335afbb58be4e0298bd7117a34e39d345ff13d859e"'; \
    ./configure --prefix=/opt/soc-sqlite --enable-fts5 --disable-static --disable-readline; \
    make -j2; \
    make install; \
    rm -rf /tmp/sqlite-autoconf-3510300 /tmp/soc-sqlite.tar.gz

ENV LD_LIBRARY_PATH=/opt/soc-sqlite/lib
RUN python -c 'import sqlite3; assert sqlite3.sqlite_version_info == (3, 51, 3), sqlite3.sqlite_version'
